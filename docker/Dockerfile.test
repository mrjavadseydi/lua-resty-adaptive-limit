# Test/benchmark harness for lua-resty-adaptive-limit.
#
# One image is used for everything (busted unit tests, Test::Nginx
# integration tests, deterministic simulations, wrk benchmarks and soak
# runs) so local development and CI exercise identical tooling.
#
# Build:  docker build -t lua-resty-adaptive-limit/harness -f docker/Dockerfile.test .
#         (or `make image`)

ARG OPENRESTY_IMAGE=openresty/openresty:1.31.1.1-3-jammy
FROM ${OPENRESTY_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# perl + prove (integration tests), cpanminus (Test::Nginx), build tools
# (wrk, native rock deps), unzip (luarocks), apache2-utils (ab fallback),
# procps (soak memory sampling).
RUN apt-get update && apt-get install -y --no-install-recommends \
        perl \
        cpanminus \
        build-essential \
        git \
        ca-certificates \
        curl \
        unzip \
        procps \
        apache2-utils \
    && rm -rf /var/lib/apt/lists/*

# Test::Nginx for integration tests. --notest keeps the image lean; the
# suite itself is the real test.
RUN cpanm --notest Test::Nginx

# busted for pure-Lua unit tests and simulations.
RUN luarocks install busted 2>&1 | tail -2

# wrk for load generation (benchmarks + soak).
RUN git clone --depth=1 https://github.com/wg/wrk.git /tmp/wrk \
    && make -C /tmp/wrk -j"$(nproc)" \
    && cp /tmp/wrk/wrk /usr/local/bin/wrk \
    && rm -rf /tmp/wrk

ENV PATH=/usr/local/openresty/luajit/bin:/usr/local/openresty/bin:/usr/local/openresty/nginx/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV TEST_NGINX_BINARY=/usr/local/openresty/nginx/sbin/nginx
ENV LUA_PATH=/work/lib/?.lua;/work/lib/?/init.lua;./?.lua;

WORKDIR /work
CMD ["/bin/bash"]
